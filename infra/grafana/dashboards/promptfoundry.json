{
  "title": "PromptFoundry — operations",
  "uid": "promptfoundry-ops",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests by status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (status) (rate(promptfoundry_http_requests_total[5m]))", "legendFormat": "{{status}}"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(promptfoundry_http_request_seconds_bucket[5m])))"}]
    },
    {
      "type": "stat",
      "title": "LLM spend (AUD) — rolling",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
      "targets": [{"expr": "sum(promptfoundry_llm_cost_aud_micros_total) / 1000000"}]
    },
    {
      "type": "gauge",
      "title": "Budget utilisation",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8},
      "fieldConfig": {"defaults": {"max": 1, "unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.8}, {"color": "red", "value": 1}]}}},
      "targets": [{"expr": "promptfoundry_budget_used_ratio"}]
    },
    {
      "type": "timeseries",
      "title": "Evaluation runs",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8},
      "targets": [{"expr": "sum by (outcome) (rate(promptfoundry_eval_runs_total[1h]))", "legendFormat": "{{outcome}}"}]
    },
    {
      "type": "timeseries",
      "title": "Governance decisions",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [{"expr": "sum by (decision) (rate(promptfoundry_governance_decisions_total[5m]))", "legendFormat": "{{decision}}"}]
    },
    {
      "type": "timeseries",
      "title": "Signals ingested vs rejected",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [
        {"expr": "sum(rate(promptfoundry_signals_ingested_total[5m]))", "legendFormat": "ingested"},
        {"expr": "sum by (reason) (rate(promptfoundry_signals_rejected_total[5m]))", "legendFormat": "rejected: {{reason}}"}
      ]
    }
  ]
}

# PromptFoundry — environment template
#
# Copy to `.env` and edit. EVERYTHING IS OPTIONAL: with no keys the system runs
# end-to-end on the deterministic mock provider, local SQLite and local artifact
# storage. Keys only unlock official APIs, real model quality and real embeddings.

# ---------------------------------------------------------------- core -------
PF_ENV=local
PF_LOG_LEVEL=INFO
PF_JURISDICTION=AU
PF_DATA_REGION=ap-southeast-2

# Storage: sqlite by default; Postgres + pgvector for production.
PF_DATA_DIR=var
# DATABASE_URL=postgresql+psycopg://promptfoundry:promptfoundry@localhost:5432/promptfoundry
PF_ARTIFACTS_DIR=var/artifacts
PF_PERMITTED_CORPORA_DIR=demo/data/corpora

# --------------------------------------------------------------- budgets -----
# All budgets are AUD *micros* (1 AUD = 1_000_000). Defaults: A$6/day, A$30/week
# LLM and A$5/week infra — inside the A$50–150/week operating envelope.
PF_BUDGET_DAILY_LLM_MICROS=6000000
PF_BUDGET_WEEKLY_LLM_MICROS=30000000
PF_BUDGET_WEEKLY_INFRA_MICROS=5000000
PF_BUDGET_ENFORCED=true
PF_BUDGET_ALERT_RATIO=0.8
PF_AUD_PER_USD=1.55

# ---------------------------------------------------------------- auth -------
# Session tokens are opaque, stored as SHA-256 digests. Set the signing key
# before publishing anything: it HMACs prompt packs and version records.
PF_SIGNING_KEY=change-me-before-any-real-deployment
PF_SESSION_TTL_HOURS=12
PF_ALLOW_SELF_REGISTRATION=true
PF_RATE_LIMIT_PER_MINUTE=240
# First-run bootstrap admin (optional; you can also register in the UI/API).
PF_ADMIN_EMAIL=
PF_ADMIN_PASSWORD=

# ------------------------------------------------------------ governance -----
# Human approval is ON by default. Auto-publish additionally needs
# PF_AUTO_PUBLISH_ENABLED=true AND the `publishing.auto` runtime flag.
PF_REQUIRE_HUMAN_APPROVAL=true
PF_AUTO_PUBLISH_ENABLED=false
PF_IP_BLOCK_THRESHOLD=0.92
PF_IP_WARN_THRESHOLD=0.80
PF_IP_SHINGLE_OVERLAP_THRESHOLD=0.18

# ------------------------------------------------------- LLM providers ------
# Leave empty to use the deterministic simulator (free, offline, honest).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# PF_LLM_DEFAULT_MODEL=
# PF_LLM_JUDGE_MODEL=
# PF_LLM_TIMEOUT_SECONDS=60
# PF_LLM_MAX_RETRIES=2

# Embeddings: auto → OpenAI if a key exists, else the offline hashing embedder.
PF_EMBEDDING_PROVIDER=auto
PF_EMBEDDING_MODEL=text-embedding-3-small
PF_EMBEDDING_DIM=256

# --------------------------------------------------------------- queue ------
# With no broker, Celery runs eagerly in-process (fine for one box / demos).
REDIS_URL=
CELERY_BROKER_URL=
CELERY_TASK_ALWAYS_EAGER=true

# ------------------------------------------------- construction settings ----
PF_CLUSTER_EPS=0.34
PF_CLUSTER_MIN_SIZE=3
PF_DRIFT_THRESHOLD=0.35
PF_MAX_UPLOAD_ROWS=50000
PF_MAX_UPLOAD_BYTES=26214400

# ------------------------------------------------------ official APIs -------
# Secrets are referenced by ENV VAR NAME in source configs — never stored in the DB.
# Each connector stays "not ready" until its key is present, and refuses to run
# unless the source's permission basis matches its allowed bases.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=promptfoundry/0.1 (operator contact: you@example.com)
STACKEXCHANGE_KEY=
YOUTUBE_API_KEY=

# ------------------------------------------------------------ storefront ----
# Default is the mock adapter (writes an artifact, no network). Real adapters are
# official-API only and fall back to mock with a warning when creds are missing.
PF_STOREFRONT=mock
GUMROAD_ACCESS_TOKEN=
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=

# ---------------------------------------------------------- observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=promptfoundry-api
PF_METRICS_ENABLED=true

# ---------------------------------------------------------------- CORS ------
PF_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

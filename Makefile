# PromptFoundry — developer entry points
#
# Everything below works with **no API keys and no external services** except
# `make up` (Docker Compose for Postgres/Redis) and `make eval` against real models.

PY ?= .venv/bin/python
PIP ?= .venv/bin/pip
DATA_DIR ?= var
export PYTHONPATH := .

.DEFAULT_GOAL := help
.PHONY: help venv install demo seed api worker beat test lint format typecheck migrate \
        revision docker up down logs eval clean reset docs

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-12s\033[0m %s\n", $$1, $$2}'

venv: ## Create the virtualenv
	python3 -m venv .venv
	$(PIP) install --upgrade pip

install: ## Install runtime + dev dependencies into .venv
	$(PIP) install -e ".[dev]"

demo: ## Seed a fresh workspace and run the full offline demo (no keys needed)
	PF_DATA_DIR=$(DATA_DIR) $(PY) -m demo.run_demo

seed: ## Seed demo data only (idempotent)
	PF_DATA_DIR=$(DATA_DIR) $(PY) -m db.seed

api: ## Run the API locally (http://127.0.0.1:8000/docs)
	PF_DATA_DIR=$(DATA_DIR) $(PY) -m uvicorn backend.main:app --reload --port 8000

worker: ## Run a Celery worker (requires CELERY_BROKER_URL, otherwise tasks run inline)
	$(PY) -m celery -A workers.celery_app.app worker -l info -Q promptfoundry

beat: ## Run the Celery beat scheduler
	$(PY) -m celery -A workers.celery_app.app beat -l info

test: ## Run the test suite
	PF_DATA_DIR=$(DATA_DIR)/test PF_ENV=test $(PY) -m pytest

lint: ## Lint (ruff)
	$(PY) -m ruff check .

format: ## Auto-fix formatting/lint issues
	$(PY) -m ruff check --fix . && $(PY) -m ruff format .

typecheck: ## Static types (mypy, best-effort)
	$(PY) -m mypy backend core db evaluation governance market_intel prompt_lab publishing

migrate: ## Apply database migrations
	$(PY) -m alembic upgrade head

revision: ## Create a new autogenerated migration (m="message")
	$(PY) -m alembic revision --autogenerate -m "$(m)"

up: ## Start Postgres (pgvector) + Redis + Prometheus + Grafana
	docker compose -f infra/docker-compose.yml up -d postgres redis prometheus grafana

down: ## Stop the local stack
	docker compose -f infra/docker-compose.yml down

logs: ## Tail API logs from the stack
	docker compose -f infra/docker-compose.yml logs -f api worker

docker: ## Build and start the full stack (API + worker + beat + infra)
	docker compose -f infra/docker-compose.yml up --build -d

eval: ## One-off live evaluation (needs a provider key): make eval VERSION=<id>
	PF_DATA_DIR=$(DATA_DIR) $(PY) -c "from db.session import session_scope; \
	from evaluation.runner import RunConfig, run_evaluation; \
	session_scope().__enter__() and None" && \
	PF_DATA_DIR=$(DATA_DIR) $(PY) -m evaluation.cli --version $(VERSION)

clean: ## Remove caches and build artefacts
	find . -type d -name __pycache__ -prune -exec rm -rf {} +
	rm -rf .pytest_cache .ruff_cache .mypy_cache build dist *.egg-info

reset: ## Delete the local database and artifacts (asks for confirmation)
	@printf "Delete $(DATA_DIR)/promptfoundry.db and $(DATA_DIR)/artifacts? [y/N] " && read ans && \
		[ "$$ans" = "y" ] && rm -rf $(DATA_DIR)/promptfoundry.db $(DATA_DIR)/artifacts || echo "aborted"
